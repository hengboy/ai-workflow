{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NavigationRefreshCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_target", "authorized_module_roots", "changed_paths", "maintenance_authorized", "navigation"],
  "properties": {
    "version": { "const": 1 },
    "task_target": { "type": "string", "minLength": 1 },
    "authorized_module_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "changed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "maintenance_authorized": { "const": true },
    "navigation": { "$ref": "schemas/navigation.schema.json" }
  }
}
