{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/review-repair-resolution.schema.json",
  "title": "FindingRecheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "result_type", "finding_id", "status", "evidence_paths", "evidence_digests", "repair_diff_digest", "source_review_receipt_digest", "message"],
  "properties": {
    "result_version": { "const": "2.0.0" },
    "result_type": { "const": "finding-recheck" },
    "finding_id": { "$ref": "#/definitions/findingId" },
    "status": { "enum": ["closed", "open"] },
    "evidence_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "evidence_digests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/digest" } },
    "repair_diff_digest": { "$ref": "#/definitions/digest" },
    "source_review_receipt_digest": { "$ref": "#/definitions/digest" },
    "message": { "type": "string", "minLength": 1, "maxLength": 20000 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "closed" } }, "required": ["status"] },
      "then": { "properties": { "evidence_paths": { "minItems": 1 } }, "required": ["evidence_paths"] }
    }
  ],
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "findingId": { "type": "string", "pattern": "^finding-sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$" }
  }
}
