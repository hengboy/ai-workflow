{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/call-checkpoint.schema.json",
  "title": "CallCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_version", "call_id", "call_ordinal", "action_id", "task_id", "descriptor_digest", "attempt", "attempt_id", "state", "result", "audit_digest"],
  "properties": {
    "checkpoint_version": { "const": "2.0.0" },
    "call_id": { "$ref": "#/definitions/callId" },
    "call_ordinal": { "type": "integer", "minimum": 1 },
    "action_id": { "$ref": "#/definitions/actionId" },
    "task_id": { "type": "string", "minLength": 1 },
    "descriptor_digest": { "$ref": "#/definitions/digest" },
    "attempt": { "type": "integer", "minimum": 1 },
    "attempt_id": { "$ref": "#/definitions/callId" },
    "state": { "const": "checkpointed" },
    "result": { "$ref": "#/definitions/codingAgentResult" },
    "audit_digest": { "$ref": "#/definitions/digest" },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$" },
    "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "callId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]*$" },
    "codingAgentResult": {
      "type": "object", "additionalProperties": false,
      "required": ["result_version", "status", "summary", "changed_paths", "evidence", "tests", "findings", "git_refs", "support_requests"],
      "properties": { "result_version": { "const": "2.0.0" }, "status": { "enum": ["done", "blocked", "failed"] }, "summary": { "type": "string", "maxLength": 20000 }, "changed_paths": { "type": "array" }, "evidence": { "type": "array" }, "tests": { "type": "array" }, "findings": { "type": "array" }, "git_refs": { "type": "array" }, "support_requests": { "type": "array" }, "value": {} }
    }
  }
}
