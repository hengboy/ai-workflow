{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/settings.schema.json",
  "title": "Settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "output_language": { "enum": ["en", "zh-CN"] },
    "active_profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    }
  }
}
