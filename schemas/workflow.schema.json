{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/workflow.schema.json",
  "title": "Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "host", "input_digests", "concurrency", "policies", "phases", "nodes", "gates"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "type": "string", "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "host": { "enum": ["codex", "claude", "opencode"] },
    "input_digests": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/definitions/digest" }
    },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 3 },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "default_timeout_ms", "repair_rounds", "push_allowed", "rebase_allowed"],
      "properties": {
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 2 },
        "default_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "repair_rounds": { "const": 1 },
        "push_allowed": { "const": false },
        "rebase_allowed": { "const": false }
      }
    },
    "phases": {
      "type": "array",
      "const": ["preflight", "baseline", "plan_setup", "executing", "validating", "reviewing", "repairing", "integrating"]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/definitions/gate" }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "kind", "role", "depends_on", "read_scope", "write_scope", "timeout_ms", "retry", "result_schema", "on_failure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "phase": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "kind": { "enum": ["agent", "parallel", "pipeline", "phase", "gate", "git"] },
        "role": { "enum": ["file-explorer", "git-operator", "task-worker", "backend", "frontend", "test", "standards-review", "spec-review", "researcher", "documentation-maintainer"] },
        "task_id": { "type": "string", "pattern": "^task-[0-9]{3}(?:-[a-z0-9-]+)?$" },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "read_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
        "write_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
        "allowed_commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "retry": { "type": "integer", "minimum": 0, "maximum": 2 },
        "result_schema": { "const": "schemas/result.schema.json" },
        "on_failure": { "enum": ["pause", "retry", "repair_once"] }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "after", "kind"],
      "properties": {
        "id": { "type": "string" },
        "after": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "kind": { "enum": ["tests-pass", "reviews-pass-or-repair", "context-valid", "approval-valid", "baseline-stable"] }
      }
    }
  }
}
