{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/coding-event.schema.json",
  "title": "CodingRunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_version", "seq", "at", "run_id", "fencing_epoch", "type", "payload"],
  "properties": {
    "event_version": { "const": "2.0.0" },
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "run_id": { "$ref": "#/definitions/runId" },
    "fencing_epoch": { "type": "integer", "minimum": 1 },
    "type": { "$ref": "#/definitions/codingEventType" },
    "call_id": { "$ref": "#/definitions/callId" },
    "task_id": { "type": "string", "minLength": 1 },
    "transaction_id": { "$ref": "#/definitions/callId" },
    "payload": { "$ref": "#/definitions/eventPayload" }
  },
  "definitions": {
    "runId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$" },
    "callId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$" },
    "codingEventType": {
      "title": "CodingEventType",
      "enum": ["run/start", "run/lease-acquired", "run/cancel-requested", "run/cancelling", "run/cancelled", "run/end", "run/error", "workflow/phase", "workflow/log", "agent/start", "agent/end", "call/prepared", "call/dispatch-intent", "call/running", "call/observed", "call/checkpointed", "call/retry-scheduled", "call/business-failed", "call/blocked", "call/audit-failed", "call/reconcile-required", "control/prepared", "control/intent", "control/observed", "control/cancelled", "control/reconcile-required", "action/remediated", "action/skipped", "task/admitted", "task/skipped", "task/blocked", "task/finalize-intent", "task/finalized", "task/commit-intent", "task/committed", "scope/lease-acquired", "scope/lease-released", "scope/queued", "test/result", "review/result", "gate/started", "gate/passed", "gate/failed", "repair/started", "repair/completed", "git/baseline", "git/project-lease-acquired", "git/project-lease-released", "git/worktree-intent", "git/worktree-created", "git/commit-intent", "git/commit-observed", "git/merge-intent", "git/merge-observed", "git/integration-intent", "git/integration-observed", "git/cleanup-intent", "git/cleanup-observed", "resource/create-intent", "resource/created", "resource/retained", "resume/replayed", "resume/diverged"]
    },
    "reviewFindingV2": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "ordinal", "source_gate", "severity", "message", "message_digest", "applicable_action_ids"],
      "properties": { "finding_id": { "type": "string", "pattern": "^finding-sha256:[a-f0-9]{64}$" }, "ordinal": { "type": "integer", "minimum": 1 }, "source_gate": { "enum": ["standards-review", "spec-review"] }, "severity": { "enum": ["error", "warning", "info"] }, "message": { "type": "string", "minLength": 1 }, "message_digest": { "$ref": "#/definitions/digest" }, "path": { "$ref": "#/definitions/path" }, "applicable_action_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } }
    },
    "codingAgentResult": {
      "type": "object", "additionalProperties": false,
      "required": ["result_version", "status", "summary", "changed_paths", "evidence", "tests", "findings", "git_refs", "support_requests"],
      "properties": { "result_version": { "const": "2.0.0" }, "status": { "enum": ["done", "blocked", "failed"] }, "summary": { "type": "string" }, "changed_paths": { "type": "array" }, "evidence": { "type": "array" }, "tests": { "type": "array" }, "findings": { "type": "array" }, "git_refs": { "type": "array" }, "support_requests": { "type": "array" }, "value": {} }
    },
    "eventPayload": {
      "title": "CodingEventPayload",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "const": "worker-thread-trusted" },
        "manifest_digest": { "$ref": "#/definitions/digest" },
        "script_digest": { "$ref": "#/definitions/digest" },
        "args_digest": { "$ref": "#/definitions/digest" },
        "descriptor_digest": { "$ref": "#/definitions/digest" },
        "checkpoint_digest": { "$ref": "#/definitions/digest" },
        "receipt_digest": { "$ref": "#/definitions/digest" },
        "audit_digest": { "$ref": "#/definitions/digest" },
        "repair_diff_digest": { "$ref": "#/definitions/digest" },
        "source_review_receipt_digest": { "$ref": "#/definitions/digest" },
        "policy_digest": { "$ref": "#/definitions/digest" },
        "resource_id": { "type": "string", "minLength": 1 },
        "child_id": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "original_action_id": { "type": "string", "minLength": 1 },
        "repair_action_id": { "type": "string", "minLength": 1 },
        "replacement_test_id": { "type": "string", "minLength": 1 },
        "control_id": { "$ref": "#/definitions/callId" },
        "call_ordinal": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "attempt_id": { "$ref": "#/definitions/callId" },
        "admission_ordinal": { "type": "integer", "minimum": 1 },
        "state": { "type": "string", "minLength": 1 },
        "stop_reason": { "enum": ["completed", "cancelled", "error", "blocked"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "message": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "error": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "reconciled": { "type": "boolean" },
        "finding_id": { "type": "string", "pattern": "^finding-sha256:[a-f0-9]{64}$" },
        "finding_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^finding-sha256:[a-f0-9]{64}$" } },
        "evidence_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
        "evidence_digests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/digest" } },
        "changed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
        "branch": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "target_head": { "type": "string", "minLength": 1 },
        "expected_head": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/definitions/path" },
        "kind": { "type": "string", "minLength": 1 },
        "resource_kinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "findings": { "type": "array", "items": { "$ref": "#/definitions/reviewFindingV2" } },
        "result": { "$ref": "#/definitions/codingAgentResult" },
        "gate_id": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "merge_commit": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 }
      }
    }
  }
}
