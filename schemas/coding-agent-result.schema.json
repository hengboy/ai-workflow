{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/coding-agent-result.schema.json",
  "title": "CodingAgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "status", "summary", "changed_paths", "evidence", "tests", "findings", "git_refs", "support_requests"],
  "properties": {
    "result_version": { "const": "2.0.0" },
    "status": { "enum": ["done", "blocked", "failed"] },
    "summary": { "type": "string", "maxLength": 20000 },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "tests": { "type": "array", "items": { "$ref": "#/definitions/testResult" } },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/reviewFindingDraft" } },
    "git_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "support_requests": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 20000 } },
    "value": {}
  },
  "definitions": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$" },
    "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "output": { "type": "string", "maxLength": 50000 }
      }
    },
    "reviewFindingDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "applicable_action_ids"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "path": { "$ref": "#/definitions/path" },
        "applicable_action_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/actionId" } }
      }
    },
    "reviewFindingV2": {
      "title": "ReviewFindingV2",
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "ordinal", "source_gate", "severity", "message", "message_digest", "applicable_action_ids"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^finding-sha256:[a-f0-9]{64}$" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "source_gate": { "enum": ["standards-review", "spec-review"] },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "message_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "path": { "$ref": "#/definitions/path" },
        "applicable_action_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/actionId" } }
      }
    }
  }
}
