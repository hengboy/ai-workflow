{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-workflow.local/schemas/packet.schema.json",
  "title": "AgentPacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "run_id", "plan_id", "role", "objective", "cwd", "read_paths", "write_paths", "evidence", "screenshot_dir", "allowed_commands", "timeout_ms", "result_schema"],
  "properties": {
    "packet_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "role": { "enum": ["file-explorer", "git-operator", "task-worker", "backend", "frontend", "test", "standards-review", "spec-review", "researcher", "documentation-maintainer"] },
    "objective": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "read_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "write_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "screenshot_dir": { "type": "string", "pattern": "^\\.ai-workflow/plans/.+/screenshot/?$" },
    "allowed_commands": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
    "result_schema": { "const": "schemas/result.schema.json" }
  }
}
